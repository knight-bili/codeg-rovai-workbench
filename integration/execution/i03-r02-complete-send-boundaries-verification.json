  "qualification": {
    "PC02": "真实默认输入和画布分别保留不同本机正文、附件及引用；经完整工作区往返后分别实际发送，两处不相互清空，乙卡输入逐值保持。",
    "PC11": "真实Core拒绝别卡quote ID、其他私聊消息引用及拿另一卡working令牌修改引用/附件；两份草稿和原完整工作副本不变，另一卡不暴露令牌。",
    "PC14": "只读读取真实持久Managed Blob，核对字节数/SHA与accepted交接摘要；实际ACP收到整个Blob原文；路径内容、两段非源顺序引用、原section/formatter版本及无画布ID字段核定。",
    "PC15": "源文件相同长度改内容、缺失、同名同内容换文件身份三种情况下，实际原生提交均明确拒绝；正文、材料、revision、另一卡、消息及Run数量不变，未借用同名源。",
    "PC16": "同一私聊两张卡真实连续提交到原FIFO，等待期间无额外Run；精确取消阻塞Run后，两个输入按原次序进入实际ACP并成功完成，一条输入对应一个Run。"
  },
  "scope_boundary": "当前Windows真实Desktop/Core、固定本机ACP协议交接与只读数据库独立证据；不宣称外部模型推理、其他平台或整个I03通过。PC21/22进程中断仍开放。",
  "database_boundary": "业务行只由生产命令创建，证据连接DatabaseSync readOnly:true；仅在已验证属于隔离Core的测试源文件上注入变化，修改前保存源字节及归属快照。",
  "ui_followup_in_R09": "attachment_missing目前显示保留输入的通用错误指引；R09既定错误态应具体提示文件缺失与重新选择，不把本次通过写成全部文案/UI通过。",
  "failed_attempts": {
